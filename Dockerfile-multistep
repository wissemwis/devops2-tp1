# ---------- Étape 1 : dépendances ----------
# Installe toutes les dépendances (y compris dev) nécessaires au build
FROM node:22-alpine AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci

# ---------- Étape 2 : build ----------
# Compile l'application Next.js en mode production
FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ---------- Étape 3 : exécution ----------
# Image finale légère : uniquement le serveur autonome et les fichiers statiques
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Utilisateur non root pour exécuter l'application
RUN addgroup -S nodejs && adduser -S nextjs -G nodejs

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

# Port d'écoute de l'application
EXPOSE 3000

# Démarrage du serveur Next.js autonome
CMD ["node", "server.js"]
